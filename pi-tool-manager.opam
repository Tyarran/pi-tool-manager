opam-version: "2.0"
synopsis: "pi extension to manage and restrict the tools available to the LLM"
maintainer: ["Romain Commandé <tyarran@proton.me>"]
authors: ["Romain Commandé <tyarran@proton.me>"]
license: "MIT"
homepage: "https://github.com/Tyarran/pi-tool-manager"
bug-reports: "https://github.com/Tyarran/pi-tool-manager/issues"
depends: [
  "ocaml" {>= "5.5" & < "5.6"}
  "dune" {>= "3.21"}
  "melange" {>= "7.0.1"}
  "reason" {>= "3.18.0"}
  "melange-jest" {with-test & >= "0.2.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
dev-repo: "git+https://github.com/Tyarran/pi-tool-manager.git"
